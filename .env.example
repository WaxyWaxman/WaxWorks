# Wax Works — environment variable NAMES (A-100, A-109). Values live in the platform:
# Vercel environment variables per environment, Supabase Vault for the PIN
# pepper (A-89). No value is ever written into a repository file.
#
# Public by construction (row-level security scopes every read; A-4 every write):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
#
# Server runtime only (A-91, A-100). The secret key is what A-91 calls the
# service-role key (A-109). Never prefixed NEXT_PUBLIC_, never in a bundle,
# never in e2e/. Read only by A-91's four Auth handlers.
SUPABASE_SECRET_KEY=
SENTRY_DSN=
